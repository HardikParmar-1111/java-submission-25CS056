<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>oop.minibank</groupId>
    <artifactId>mini-bank</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <testSourceDirectory>${project.basedir}/tests</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <includes>
                        <include>1st/**/*.java</include>
                        <include>2nd/**/*.java</include>
                        <include>3rd/**/*.java</include>
                        <include>4th/**/*.java</include>
                        <include>5th/**/*.java</include>
                        <include>6th/**/*.java</include>
                        <include>7th/**/*.java</include>
                        <include>8th/**/*.java</include>
                        <include>9th/**/*.java</include>
                        <include>10th/**/*.java</include>
                        <include>11th/**/*.java</include>
                        <include>12th/**/*.java</include>
                        <include>13th/**/*.java</include>
                        <include>14th/**/*.java</include>
                    </includes>
                    <testIncludes>
                        <testInclude>**/*.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>MiniBank</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Class-Path>dependencies/</Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
